# ============================================================
# UGANDA PRIMARY AI LEARNING SYSTEM - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DB_NAME=uganda_learning_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=your-jwt-signing-key

# AI Engine - LOCAL (Primary - Free)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_DEEPSEEK_MODEL=deepseek-r1:7b
OLLAMA_MISTRAL_MODEL=mistral:7b
AI_PRIMARY_PROVIDER=ollama

# AI Engine - CLOUD (Optional - Paid)
OPENAI_API_KEY=your-openai-key-optional
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-key-optional
GEMINI_MODEL=gemini-1.5-flash
AI_FALLBACK_PROVIDER=openai

# Storage - Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
USE_CLOUDINARY=True

# Storage - AWS S3 (Alternative)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=uganda-learning-bucket
AWS_S3_REGION_NAME=us-east-1
USE_S3=False

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=Uganda Learning <noreply@ugandalearn.com>

# SMS (Optional - Africa's Talking)
AFRICAS_TALKING_USERNAME=your-username
AFRICAS_TALKING_API_KEY=your-api-key
SMS_ENABLED=False

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
FCM_SERVER_KEY=your-fcm-server-key

# Sentry (Error Monitoring)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# App Settings
APP_NAME=Uganda Primary AI Learning
SCHOOL_NAME=Uganda Primary School
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
PASSWORD_RESET_TIMEOUT_HOURS=24
MAX_FILE_UPLOAD_SIZE_MB=10
